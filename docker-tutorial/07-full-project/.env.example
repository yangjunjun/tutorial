# =============================================================================
# 全栈应用环境变量模板
# =============================================================================
# 使用方法：
#   1. 复制本文件为 .env：cp .env.example .env
#   2. 编辑 .env 文件，填入实际的密码和配置值
#   3. 请勿将 .env 文件提交到版本控制系统
# =============================================================================

# ── 数据库配置 ─────────────────────────────────────────────────────────────────
# 数据库名称
DB_NAME=fullstack_db
# 数据库用户名
DB_USER=appuser
# 数据库密码（必须修改！使用强密码，建议 16 位以上包含大小写字母、数字和特殊字符）
DB_PASSWORD=CHANGE_ME_strong_password_here
# 数据库端口映射（生产环境建议绑定 127.0.0.1 限制访问）
DB_EXPOSE_PORT=127.0.0.1:5432

# ── Redis 配置 ─────────────────────────────────────────────────────────────────
# Redis 密码（必须修改！）
REDIS_PASSWORD=CHANGE_ME_redis_password_here

# ── 应用配置 ───────────────────────────────────────────────────────────────────
# JWT 密钥（必须修改！用于签发身份令牌，建议至少 32 个随机字符）
JWT_SECRET=CHANGE_ME_at_least_32_random_characters
# 日志级别：debug / info / warn / error
LOG_LEVEL=warn
# 运行环境：production / development
NODE_ENV=production

# ── 前端配置 ───────────────────────────────────────────────────────────────────
# 前端调用的 API 地址（相对路径或绝对 URL）
REACT_APP_API_URL=/api

# ── Nginx / 网络配置 ──────────────────────────────────────────────────────────
# HTTP 监听端口
HTTP_PORT=80
# HTTPS 监听端口
HTTPS_PORT=443
# 域名（用于 SSL 证书和 Nginx server_name 配置）
DOMAIN_NAME=example.com

# ── 镜像版本 ───────────────────────────────────────────────────────────────────
# Docker 镜像标签（可用于版本回滚）
IMAGE_TAG=latest
