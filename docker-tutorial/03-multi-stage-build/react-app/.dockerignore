# 依赖目录（会在容器内通过 npm ci 重新安装）
node_modules

# 构建产物（会在容器内重新构建）
build

# Git 相关
.git
.gitignore
.gitattributes

# Docker 相关
Dockerfile
docker-compose*.yml
.dockerignore

# 文档文件
*.md
docs/

# 编辑器配置
.vscode
.idea
*.swp
*.swo
*~

# 操作系统文件
.DS_Store
Thumbs.db
*.bak

# 环境变量文件（不应包含在镜像中）
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 测试相关文件
coverage/
.nyc_output/

# CI/CD 配置
.github
.gitlab-ci.yml

# 日志文件
npm-debug.log*
yarn-debug.log*
yarn-error.log*
