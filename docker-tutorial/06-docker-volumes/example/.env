# ==============================================================================
# Docker 数据持久化示例 - 环境变量配置
# 将此文件复制为 .env 并修改对应的值
# ==============================================================================

# ---- PostgreSQL 配置 ----
POSTGRES_DB=demo_db
POSTGRES_USER=demo_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_PORT=5432

# ---- 应用配置 ----
APP_IMAGE=node:20-alpine
APP_PORT=3000
NODE_ENV=production

# ---- Nginx 配置 ----
NGINX_PORT=80

# ---- 备份配置 ----
# 备份文件保留天数
BACKUP_RETENTION_DAYS=7
