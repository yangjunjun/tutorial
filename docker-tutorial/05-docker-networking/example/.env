# ============================================================
# Docker 网络教程 - 环境变量配置
# ============================================================
# 使用方法：
#   1. 复制此文件并根据需要修改值
#   2. docker compose 会自动读取同目录下的 .env 文件
#   3. 也可以通过 docker compose --env-file .env up -d 指定
# ============================================================

# ----------------------------------------------------------
# 项目配置
# ----------------------------------------------------------

# Docker Compose 项目名称（用于网络和卷的前缀）
COMPOSE_PROJECT_NAME=tutorial

# ----------------------------------------------------------
# Nginx 配置
# ----------------------------------------------------------

# Nginx 镜像版本
NGINX_VERSION=1.27-alpine

# Nginx 对外 HTTP 端口
NGINX_HTTP_PORT=80

# Nginx 对外 HTTPS 端口
NGINX_HTTPS_PORT=443

# ----------------------------------------------------------
# Web 应用配置
# ----------------------------------------------------------

# Web 应用镜像（根据实际项目替换）
WEBAPP_IMAGE=node:20-alpine

# 运行环境：development | production
APP_ENV=production

# Web 应用内部监听端口
APP_PORT=3000

# ----------------------------------------------------------
# PostgreSQL 数据库配置
# ----------------------------------------------------------

# PostgreSQL 镜像版本
POSTGRES_VERSION=16-alpine

# 数据库名称
DB_NAME=myapp

# 数据库用户名
DB_USER=appuser

# 数据库密码（生产环境请使用 Docker Secrets 或更安全的方案）
DB_PASSWORD=apppass_changeme_in_production

# 数据库端口（仅内部网络使用，不映射到宿主机）
DB_PORT=5432

# ----------------------------------------------------------
# Redis 缓存配置
# ----------------------------------------------------------

# Redis 镜像版本
REDIS_VERSION=7-alpine

# Redis 内部端口（仅内部网络使用，不映射到宿主机）
REDIS_PORT=6379

# Redis 最大内存限制
REDIS_MAX_MEMORY=128mb
