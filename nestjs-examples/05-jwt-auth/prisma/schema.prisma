// Prisma Schema 定义
// 使用 SQLite 作为数据库，定义用户模型

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// 用户模型 - 存储注册用户信息
model User {
  id        Int      @id @default(autoincrement()) // 自增主键
  username  String   @unique                        // 用户名，唯一约束
  password  String                                  // 密码（bcrypt 加密存储）
  email     String   @unique                        // 邮箱，唯一约束
  createdAt DateTime @default(now())                // 创建时间，自动填充当前时间
}
