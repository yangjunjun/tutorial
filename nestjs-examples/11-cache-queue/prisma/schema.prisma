// Prisma Schema 定义 - 缓存与队列示例
// 学习点：商品数据模型，包含分类、浏览量和销量统计

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// 商品模型 - 用于演示缓存策略和数据库优化
model Product {
  id          Int      @id @default(autoincrement())
  name        String
  price       Float
  stock       Int      @default(0)
  category    String   @default("general")   // 商品分类
  description String   @default("")          // 商品描述
  viewCount   Int      @default(0)           // 浏览次数（用于热门商品排序）
  salesCount  Int      @default(0)           // 销售数量
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 用户模型 - 用于演示邮件队列
model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String   @unique
  createdAt DateTime @default(now())
  orders    Order[]
}

// 简易订单模型 - 用于演示 N+1 问题和订单确认邮件
model Order {
  id          Int      @id @default(autoincrement())
  orderNo     String   @unique
  totalAmount Float
  status      String   @default("PENDING")
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
}
