# ===========================================
# 环境变量配置文件
# ===========================================
# 使用方式：复制此文件为 .env 并填写实际值
#   cp .env.example .env
#
# 在 Docker 部署中，这些值通过以下方式注入：
# - docker-compose.yml 的 environment 字段
# - Kubernetes 的 ConfigMap / Secret
# - 云平台的环境变量管理服务（如 AWS Parameter Store）
# ===========================================

# ----- 应用基础配置 -----

# 应用运行环境
# 可选值：development | production | test
# 不同环境会加载不同的配置和日志级别
NODE_ENV=development

# 应用监听端口
# Docker 容器内默认使用 3000，通过端口映射暴露给宿主机
PORT=3000

# 应用名称（用于日志和监控标识）
APP_NAME=nestjs-docker-demo

# 应用版本号（通常由 CI/CD 自动注入）
APP_VERSION=1.0.0

# ----- 日志配置 -----

# 日志级别：debug | info | warn | error
# 开发环境建议 debug，生产环境建议 info 或 warn
LOG_LEVEL=info

# ----- CORS 配置 -----

# 允许的跨域请求来源
# 生产环境应限制为具体的域名，如：https://example.com
CORS_ORIGIN=*

# ----- 安全配置 -----

# API 密钥（生产环境请使用密钥管理服务生成强密钥）
API_KEY=your-api-key-change-in-production

# JWT 密钥（如果后续添加认证功能）
# JWT_SECRET=your-jwt-secret-change-in-production

# ----- 数据库配置（预留，当前使用内存数据） -----

# 数据库连接字符串
# DATABASE_URL=postgresql://user:password@localhost:5432/nestjs_db

# Redis 连接字符串（用于缓存和会话管理）
# REDIS_URL=redis://localhost:6379

# ----- 监控配置（预留） -----

# Prometheus metrics 访问密码（空表示不需要认证）
# METRICS_AUTH_PASSWORD=

# ----- 健康检查配置 -----

# 内存使用阈值（MB），超过此值健康检查将失败
HEALTH_MEMORY_THRESHOLD=300

# 磁盘使用率阈值（百分比），超过此值健康检查将失败
HEALTH_DISK_THRESHOLD=90
