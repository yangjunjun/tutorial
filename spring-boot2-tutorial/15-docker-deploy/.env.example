# ============================================================
# 博客系统 Docker 部署 - 环境变量配置文件
# ============================================================
#
# 使用方式：
#   1. 复制此文件为 .env：  cp .env.example .env
#   2. 编辑 .env 文件，填入实际的密码和配置
#   3. docker compose up -d  （自动读取 .env 文件）
#
# 安全提醒：
#   - .env 文件包含敏感信息，务必添加到 .gitignore 中！
#   - 生产环境请使用强随机密码，不要使用默认值！
#   - JWT_SECRET 应使用至少 256 位的随机字符串
#
# 生成随机密码的方法：
#   openssl rand -base64 32
#   openssl rand -hex 32
#
# ============================================================

# ==================== 应用配置 ====================

# 博客应用对外暴露的端口
APP_PORT=8080

# Spring Boot 激活的 Profile（dev/test/prod）
SPRING_PROFILES_ACTIVE=prod

# JVM 运行参数（JDK 8 语法）
# 开发环境：256m-512m
# 生产环境：512m-1024m（在 docker-compose.prod.yml 中会覆盖）
JAVA_OPTS=-Xms256m -Xmx512m

# Docker 镜像版本号（用于 docker-compose.prod.yml）
APP_VERSION=latest

# Docker 镜像仓库地址（用于 docker-compose.prod.yml）
DOCKER_REGISTRY=your-registry

# ==================== MySQL 配置 ====================

# MySQL root 用户密码
# 生成方法：openssl rand -base64 24
MYSQL_ROOT_PASSWORD=your_secure_root_password_here

# MySQL 数据库名称
MYSQL_DATABASE=blog

# MySQL 普通用户名（应用程序使用此用户连接）
MYSQL_USER=blog

# MySQL 普通用户密码
# 生成方法：openssl rand -base64 24
MYSQL_PASSWORD=your_secure_blog_password_here

# MySQL 对外暴露的端口（生产环境建议关闭）
MYSQL_PORT=3306

# ==================== Redis 配置 ====================

# Redis 密码（留空表示不设置密码）
# 生产环境务必设置密码！
# 生成方法：openssl rand -base64 24
REDIS_PASSWORD=your_redis_password_here

# Redis 对外暴露的端口（生产环境建议关闭）
REDIS_PORT=6379

# ==================== JWT 配置 ====================

# JWT 签名密钥
# 重要：必须是至少 32 个字符的随机字符串！
# 生成方法：openssl rand -base64 48
JWT_SECRET=your-256-bit-secret-key-for-jwt-token-generation-change-this

# JWT Token 过期时间（毫秒）
# 默认值 86400000 = 24 小时
# 如需 7 天：604800000
# 如需 30 天：2592000000
JWT_EXPIRATION=86400000

# ==================== 文件上传配置 ====================

# 单个文件最大上传大小
# MAX_FILE_SIZE=10MB

# ==================== Nginx 配置（生产环境） ====================

# 博客域名（用于 Nginx server_name 配置）
# DOMAIN=your-domain.com

# ==================== 邮件配置（可选） ====================
# 如果博客系统需要发送邮件（注册验证、评论通知等）

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=noreply@example.com
# SMTP_PASSWORD=your_smtp_password
