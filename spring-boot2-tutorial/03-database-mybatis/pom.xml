<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Spring Boot 父工程
        统一管理依赖版本和插件配置
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.5.12</version>
        <relativePath/>
    </parent>

    <!-- ============================================ -->
    <!-- 项目坐标（GAV）                              -->
    <!-- ============================================ -->
    <groupId>com.example</groupId>
    <artifactId>blog-api</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>blog-api</name>
    <description>Personal Blog System API - Spring Boot 2.5 Tutorial</description>

    <!-- ============================================ -->
    <!-- 项目属性                                      -->
    <!-- ============================================ -->
    <properties>
        <java.version>1.8</java.version>
        <!--
            MyBatis-Plus 版本号，统一管理，便于后续升级
            注意：Spring Boot 2.5.12 的 BOM 不管理 MyBatis-Plus 的版本，
            必须显式指定 version 属性（或像这里一样用 properties 引用）
        -->
        <mybatis-plus.version>3.5.1</mybatis-plus.version>
    </properties>

    <!-- ============================================ -->
    <!-- 依赖列表                                      -->
    <!-- ============================================ -->
    <dependencies>

        <!--
            Spring Web Starter
            包含 Spring MVC、内嵌 Tomcat、Jackson 等
            用于开发 RESTful API
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            MyBatis-Plus Spring Boot Starter
            ==========================================
            重要：Spring Boot 2.x 必须使用 mybatis-plus-boot-starter
            而非 mybatis-plus-spring-boot3-starter（后者基于 jakarta.*，
            仅适用于 Spring Boot 3）
            ==========================================
            包含：
            - MyBatis 核心框架
            - MyBatis-Plus 增强功能（BaseMapper、IService、条件构造器等）
            - Spring Boot 自动配置（数据源、SqlSessionFactory 等）
            - 与 Java EE（javax.*）生态兼容
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-boot-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!--
            MySQL JDBC 驱动（MySQL Connector/J）
            ==========================================
            scope=runtime 表示仅在运行时使用，编译时不需要
            Spring Boot 2.5.12 父 POM 已经管理了版本号（8.0.x 系列的
            mysql:mysql-connector-java），无需手动指定
            ==========================================
            注意：
            - Spring Boot 2.5.12 管理的坐标是旧坐标 mysql:mysql-connector-java
            - MySQL 官方新坐标 com.mysql:mysql-connector-j 从 8.0.31 起才提供，
              且 Spring Boot 3 才切换到新坐标
        -->
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            Lombok
            通过注解自动生成 getter/setter/构造器/日志等代码
            减少样板代码，提高开发效率
            optional=true 表示不传递给依赖本项目的其他模块
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            Spring Boot Test Starter
            包含 JUnit 5、Mockito、AssertJ、Spring Test 等
            scope=test 表示仅在测试时使用
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- ============================================ -->
    <!-- 构建配置                                      -->
    <!-- ============================================ -->
    <build>
        <plugins>
            <!--
                Spring Boot Maven 插件
                功能：
                1. mvn spring-boot:run — 命令行启动应用
                2. mvn package — 打包为可执行 Fat JAR
                3. 排除 Lombok（运行时不需要）
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
