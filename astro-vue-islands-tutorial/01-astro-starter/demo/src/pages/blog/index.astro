---
// src/pages/blog/index.astro — 博客列表页
// 对应路由：/blog
import BaseLayout from '../../components/BaseLayout.astro';

// 模拟博客文章数据（在实际项目中，这些数据来自 MDX 文件或 CMS）
const posts = [
  {
    slug: "first-post",
    title: "我的第一篇博客：认识 Astro",
    date: "2024-12-01",
    excerpt: "了解 Astro 框架的核心理念——岛屿架构，以及它如何实现默认零 JS 的高性能输出。",
    tags: ["Astro", "框架", "入门"],
  },
  {
    slug: "coming-soon",
    title: "用 MDX 编写富内容（即将推出）",
    date: "2024-12-10",
    excerpt: "探索 MDX 的强大能力：在 Markdown 中嵌入交互式组件，让内容不再只是静态文本。",
    tags: ["MDX", "内容"],
  },
  {
    slug: "coming-soon",
    title: "Vue 3 Islands 实战（即将推出）",
    date: "2024-12-20",
    excerpt: "将 Vue 3 组件作为岛屿嵌入 Astro 页面，实现局部交互而不影响整体性能。",
    tags: ["Vue 3", "Islands"],
  },
];

// 日期格式化辅助函数
function formatDate(dateStr: string): string {
  const date = new Date(dateStr);
  return date.toLocaleDateString("zh-CN", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<BaseLayout title="博客 - Astro Demo">
  <main class="blog-page">
    <h1>博客</h1>
    <p class="blog-desc">这里汇集了教程中的所有文章，按时间倒序排列。</p>

    <div class="post-list">
      {
        posts.map((post) => (
          <article class="post-card">
            <div class="post-meta">
              <time datetime={post.date}>{formatDate(post.date)}</time>
              <div class="post-tags">
                {post.tags.map((tag) => <span class="tag">{tag}</span>)}
              </div>
            </div>
            <h2 class="post-title">
              <a href={`/blog/${post.slug}`}>{post.title}</a>
            </h2>
            <p class="post-excerpt">{post.excerpt}</p>
            <a href={`/blog/${post.slug}`} class="read-more">
              阅读全文 &rarr;
            </a>
          </article>
        ))
      }
    </div>
  </main>
</BaseLayout>

<style>
  .blog-page {
    padding: 40px 0;
  }

  h1 {
    font-size: 2rem;
    color: #1a1a2e;
    margin-bottom: 8px;
  }

  .blog-desc {
    color: #666;
    margin-bottom: 32px;
  }

  /* 文章列表 */
  .post-list {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .post-card {
    background: #fff;
    border: 1px solid #e8e8e8;
    border-radius: 12px;
    padding: 28px;
    transition: border-color 0.2s;
  }

  .post-card:hover {
    border-color: #ff6b6b;
  }

  .post-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .post-meta time {
    color: #999;
    font-size: 0.85rem;
  }

  .post-tags {
    display: flex;
    gap: 8px;
  }

  .tag {
    background: #f0f4ff;
    color: #4066d5;
    padding: 2px 10px;
    border-radius: 12px;
    font-size: 0.75rem;
    font-weight: 500;
  }

  .post-title {
    font-size: 1.3rem;
    margin-bottom: 8px;
  }

  .post-title a {
    color: #1a1a2e;
    text-decoration: none;
    transition: color 0.2s;
  }

  .post-title a:hover {
    color: #ff6b6b;
  }

  .post-excerpt {
    color: #555;
    line-height: 1.7;
    margin-bottom: 16px;
    font-size: 0.95rem;
  }

  .read-more {
    color: #ff6b6b;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    transition: color 0.2s;
  }

  .read-more:hover {
    color: #e05555;
  }
</style>
