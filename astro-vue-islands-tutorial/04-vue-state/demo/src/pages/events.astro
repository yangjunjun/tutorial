---
/**
 * 事件通信 Demo 页面
 *
 * 演示使用浏览器 CustomEvent 实现跨 Vue 岛屿的松耦合通信。
 * 不依赖 Nano Stores，适合一次性通知或筛选等场景。
 */
import EventLogger from '../components/vue/EventLogger.vue';
---

<html lang="zh-CN" class="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>第四章 - CustomEvent 通信 Demo</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: #f0f2f5;
      color: #1a1a2e;
      min-height: 100vh;
    }

    .header {
      padding: 16px 32px;
      background: white;
      border-bottom: 1px solid #e9ecef;
    }

    .header h1 {
      font-size: 1.25rem;
    }

    .header a {
      color: #4361ee;
      text-decoration: none;
      font-size: 0.9rem;
    }

    .header a:hover {
      text-decoration: underline;
    }

    .container {
      max-width: 900px;
      margin: 32px auto;
      padding: 0 24px;
    }

    .demo-section {
      background: white;
      border-radius: 12px;
      padding: 24px;
      margin-bottom: 24px;
    }

    .demo-section h2 {
      font-size: 1.2rem;
      margin-bottom: 8px;
    }

    .demo-section p {
      color: #6c757d;
      font-size: 0.9rem;
      margin-bottom: 16px;
      line-height: 1.6;
    }

    .controls {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 16px;
    }

    .controls button {
      padding: 8px 16px;
      border: 1px solid #e9ecef;
      border-radius: 8px;
      background: white;
      cursor: pointer;
      font-size: 0.9rem;
      transition: all 0.2s;
    }

    .controls button:hover {
      background: #4361ee;
      color: white;
      border-color: #4361ee;
    }

    .controls button.active {
      background: #4361ee;
      color: white;
      border-color: #4361ee;
    }

    .code-note {
      background: #f8f9fa;
      border: 1px solid #e9ecef;
      border-radius: 8px;
      padding: 12px 16px;
      font-family: 'Fira Code', monospace;
      font-size: 0.85rem;
      color: #495057;
      margin-top: 12px;
    }
  </style>
</head>
<body>
  <header class="header">
    <h1>📡 CustomEvent 跨岛屿通信</h1>
    <a href="/">← 返回首页</a>
  </header>

  <div class="container">
    <!-- 说明区域 -->
    <section class="demo-section">
      <h2>什么是 CustomEvent 通信？</h2>
      <p>
        浏览器原生支持通过 <code>CustomEvent</code> 在 DOM 上派发自定义事件。
        任何组件都可以监听这些事件，实现松耦合的跨组件通信。
        不需要引入任何额外库，适合一次性通知或事件驱动场景。
      </p>
      <div class="code-note">
        <!-- 发送方 -->
        document.dispatchEvent(new CustomEvent('filter-change', {<br>
        &nbsp;&nbsp;detail: { category: '电子产品' }<br>
        }));<br><br>
        <!-- 接收方 -->
        document.addEventListener('filter-change', (e) => {<br>
        &nbsp;&nbsp;console.log(e.detail.category);<br>
        });
      </div>
    </section>

    <!-- 事件发送控制区（Astro 原生脚本，非 Vue） -->
    <section class="demo-section">
      <h2>发送筛选事件</h2>
      <p>点击下方按钮，通过 Astro 脚本派发 CustomEvent，Vue 岛屿会接收到：</p>
      <div class="controls" id="filter-controls">
        <button data-category="all" class="active">全部</button>
        <button data-category="电子产品">电子产品</button>
        <button data-category="办公用品">办公用品</button>
        <button data-category="生活用品">生活用品</button>
      </div>
    </section>

    <!-- 事件接收方：Vue 岛屿 -->
    <section class="demo-section">
      <h2>事件日志（Vue 岛屿接收）</h2>
      <p>这个 Vue 岛屿组件监听 filter-change 事件，显示收到的所有事件：</p>
      <EventLogger client:load />
    </section>
  </div>

  <!-- Astro 脚本：处理按钮点击，派发 CustomEvent -->
  <script>
    const controls = document.getElementById('filter-controls');

    if (controls) {
      controls.addEventListener('click', (e) => {
        const target = e.target as HTMLButtonElement;
        if (target.tagName !== 'BUTTON') return;

        // 更新按钮激活状态
        controls.querySelectorAll('button').forEach(btn => btn.classList.remove('active'));
        target.classList.add('active');

        const category = target.dataset.category || 'all';

        // 派发 CustomEvent —— 这就是跨岛屿通信的核心！
        document.dispatchEvent(
          new CustomEvent('filter-change', {
            detail: {
              category,
              timestamp: new Date().toLocaleTimeString('zh-CN'),
            },
          })
        );
      });
    }
  </script>
</body>
</html>
