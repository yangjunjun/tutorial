---
/**
 * 动态用户页面 - /users/[id]
 *
 * 使用 getStaticPaths 在构建时为每个用户生成静态页面。
 * 展示动态路由参数 params.id 的用法。
 */

export const prerender = true;

import { users, type User } from '../../data/users';

// getStaticPaths：告诉 Astro 需要为每个用户生成一个页面
export async function getStaticPaths() {
  return users.map((user) => ({
    params: { id: String(user.id) },
    props: { user },
  }));
}

// 当前页面的用户数据
const { user } = Astro.props as { user: User };
---

<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{user.name} - 用户详情</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: #f0f2f5;
      color: #1a1a2e;
      min-height: 100vh;
    }

    .container {
      max-width: 600px;
      margin: 0 auto;
      padding: 32px 24px;
    }

    .back-link {
      display: inline-block;
      color: #4361ee;
      text-decoration: none;
      font-size: 0.9rem;
      margin-bottom: 24px;
    }

    .back-link:hover { text-decoration: underline; }

    .profile-card {
      background: white;
      border: 1px solid #e9ecef;
      border-radius: 16px;
      overflow: hidden;
    }

    .profile-header {
      background: linear-gradient(135deg, #4361ee, #3a56d4);
      padding: 40px 32px;
      text-align: center;
      color: white;
    }

    .avatar {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      background: rgba(255,255,255,0.2);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2rem;
      font-weight: 700;
      margin: 0 auto 16px;
    }

    .profile-header h1 {
      font-size: 1.5rem;
      margin-bottom: 4px;
    }

    .profile-header .role {
      opacity: 0.8;
      font-size: 0.9rem;
    }

    .profile-body {
      padding: 32px;
    }

    .info-row {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      padding: 12px 0;
      border-bottom: 1px solid #f0f2f5;
    }

    .info-row:last-child { border-bottom: none; }

    .info-label {
      font-size: 0.85rem;
      color: #6c757d;
      min-width: 60px;
      font-weight: 500;
    }

    .info-value {
      font-size: 0.95rem;
      flex: 1;
    }

    .info-value a {
      color: #4361ee;
      text-decoration: none;
    }

    .info-value a:hover { text-decoration: underline; }

    .route-info {
      background: #f8f9fa;
      border: 1px solid #e9ecef;
      border-radius: 8px;
      padding: 16px;
      margin-top: 24px;
    }

    .route-info h3 {
      font-size: 0.9rem;
      margin-bottom: 8px;
      color: #6c757d;
    }

    .route-info code {
      display: block;
      font-size: 0.85rem;
      background: #1a1a2e;
      color: #a8e6cf;
      padding: 12px 16px;
      border-radius: 6px;
      line-height: 1.6;
    }

    /* 其他用户导航 */
    .other-users {
      margin-top: 24px;
      background: white;
      border: 1px solid #e9ecef;
      border-radius: 12px;
      padding: 20px;
    }

    .other-users h3 {
      font-size: 0.95rem;
      margin-bottom: 12px;
    }

    .user-links {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .user-links a {
      padding: 6px 14px;
      border: 1px solid #e9ecef;
      border-radius: 20px;
      text-decoration: none;
      color: inherit;
      font-size: 0.85rem;
      transition: all 0.2s;
    }

    .user-links a:hover {
      background: #4361ee;
      color: white;
      border-color: #4361ee;
    }

    .user-links a.active {
      background: #4361ee;
      color: white;
      border-color: #4361ee;
    }
  </style>
</head>
<body>
  <div class="container">
    <a href="/" class="back-link">← 返回首页</a>

    <!-- 用户资料卡片 -->
    <div class="profile-card">
      <div class="profile-header">
        <div class="avatar">{user.name[0]}</div>
        <h1>{user.name}</h1>
        <p class="role">{user.role}</p>
      </div>

      <div class="profile-body">
        <div class="info-row">
          <span class="info-label">ID</span>
          <span class="info-value">{user.id}</span>
        </div>
        <div class="info-row">
          <span class="info-label">邮箱</span>
          <span class="info-value">
            <a href={`mailto:${user.email}`}>{user.email}</a>
          </span>
        </div>
        <div class="info-row">
          <span class="info-label">简介</span>
          <span class="info-value">{user.bio}</span>
        </div>
      </div>
    </div>

    <!-- 路由信息（教学用） -->
    <div class="route-info">
      <h3>动态路由信息</h3>
      <code>
        页面文件: src/pages/users/[id].astro<br>
        当前 URL: /users/{user.id}<br>
        params.id: "{user.id}"<br>
        渲染模式: SSG (构建时静态生成)
      </code>
    </div>

    <!-- 其他用户导航 -->
    <div class="other-users">
      <h3>其他用户</h3>
      <div class="user-links">
        {users.map((u) => (
          <a
            href={`/users/${u.id}`}
            class:list={[{ active: u.id === user.id }]}
          >
            {u.name}
          </a>
        ))}
      </div>
    </div>
  </div>
</body>
</html>
