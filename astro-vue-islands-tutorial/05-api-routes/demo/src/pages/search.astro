---
/**
 * 搜索页面 - /search
 *
 * SSR 页面：每次请求时在服务端渲染。
 * 通过 URL 查询参数 (?q=关键词) 获取搜索结果。
 *
 * export const prerender = false 表示此页面使用 SSR。
 */

// 关闭预渲染 → 使用服务端渲染（SSR）
export const prerender = false;

import { users, searchUsers } from '../data/users';
import SearchBox from '../components/vue/SearchBox.vue';

// 从 URL 查询参数中获取搜索关键词
const url = new URL(Astro.request.url);
const query = url.searchParams.get('q') || '';

// 根据关键词搜索用户
const results = query ? searchUsers(query) : [];
const showResults = query.length > 0;
---

<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>搜索 {query ? `- "${query}"` : ''} - Astro 搜索</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: #f0f2f5;
      color: #1a1a2e;
      min-height: 100vh;
    }

    .container {
      max-width: 700px;
      margin: 0 auto;
      padding: 32px 24px;
    }

    h1 {
      font-size: 1.5rem;
      margin-bottom: 8px;
    }

    .subtitle {
      color: #6c757d;
      font-size: 0.9rem;
      margin-bottom: 24px;
    }

    .back-link {
      display: inline-block;
      color: #4361ee;
      text-decoration: none;
      font-size: 0.9rem;
      margin-bottom: 16px;
    }

    .back-link:hover { text-decoration: underline; }

    /* ── 搜索框区域 ── */
    .search-area {
      background: white;
      border: 1px solid #e9ecef;
      border-radius: 12px;
      padding: 24px;
      margin-bottom: 24px;
    }

    /* ── 搜索结果 ── */
    .results-section {
      background: white;
      border: 1px solid #e9ecef;
      border-radius: 12px;
      padding: 24px;
    }

    .results-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 16px;
      padding-bottom: 12px;
      border-bottom: 1px solid #e9ecef;
    }

    .results-header h2 {
      font-size: 1.1rem;
    }

    .results-count {
      color: #6c757d;
      font-size: 0.85rem;
    }

    .ssr-badge {
      display: inline-block;
      background: #e8f8f5;
      color: #1abc9c;
      padding: 2px 8px;
      border-radius: 4px;
      font-size: 0.75rem;
      font-weight: 600;
      margin-left: 8px;
    }

    /* ── 结果列表 ── */
    .result-list {
      list-style: none;
    }

    .result-item {
      padding: 16px 0;
      border-bottom: 1px solid #f0f2f5;
    }

    .result-item:last-child { border-bottom: none; }

    .result-item h3 {
      font-size: 1rem;
      margin-bottom: 4px;
    }

    .result-item h3 a {
      text-decoration: none;
      color: #4361ee;
    }

    .result-item h3 a:hover {
      text-decoration: underline;
    }

    .result-item p {
      font-size: 0.85rem;
      color: #6c757d;
      line-height: 1.5;
    }

    .result-meta {
      font-size: 0.8rem;
      color: #adb5bd;
      margin-top: 4px;
    }

    /* ── 空状态 ── */
    .no-results {
      text-align: center;
      padding: 40px 20px;
      color: #6c757d;
    }

    .no-results .icon {
      font-size: 2.5rem;
      opacity: 0.3;
      margin-bottom: 12px;
    }

    /* ── 初始状态 ── */
    .initial-state {
      text-align: center;
      padding: 40px 20px;
      color: #adb5bd;
    }

    .initial-state .icon {
      font-size: 3rem;
      margin-bottom: 12px;
    }

    .hint {
      font-size: 0.85rem;
      margin-top: 8px;
    }

    .hint code {
      background: #f0f2f5;
      padding: 2px 6px;
      border-radius: 4px;
    }

    .render-time {
      text-align: center;
      color: #adb5bd;
      font-size: 0.8rem;
      margin-top: 24px;
    }
  </style>
</head>
<body>
  <div class="container">
    <a href="/" class="back-link">← 返回首页</a>

    <h1>🔍 搜索 <span class="ssr-badge">SSR</span></h1>
    <p class="subtitle">此页面在服务端渲染，每次请求时实时搜索数据</p>

    <!-- 搜索框（Vue 岛屿：表单提交触发 SSR 页面重新加载） -->
    <div class="search-area">
      <SearchBox client:load currentQuery={query} />
    </div>

    <!-- 搜索结果 -->
    <section class="results-section">
      {showResults ? (
        results.length > 0 ? (
          <>
            <div class="results-header">
              <h2>搜索结果</h2>
              <span class="results-count">找到 {results.length} 条结果</span>
            </div>
            <ul class="result-list">
              {results.map((user) => (
                <li class="result-item">
                  <h3>
                    <a href={`/users/${user.id}`}>{user.name}</a>
                  </h3>
                  <p>{user.bio}</p>
                  <p class="result-meta">
                    {user.email} · {user.role}
                  </p>
                </li>
              ))}
            </ul>
          </>
        ) : (
          <div class="no-results">
            <div class="icon">🔍</div>
            <p>没有找到与 "<strong>{query}</strong>" 相关的结果</p>
            <p class="hint">试试搜索 <code>admin</code>、<code>张</code> 或 <code>前端</code></p>
          </div>
        )
      ) : (
        <div class="initial-state">
          <div class="icon">🔎</div>
          <p>输入关键词开始搜索</p>
          <p class="hint">可搜索用户名、邮箱、简介或角色</p>
        </div>
      )}
    </section>

    <p class="render-time">
      页面渲染时间: {new Date().toLocaleTimeString('zh-CN')} (服务端)
    </p>
  </div>
</body>
</html>
