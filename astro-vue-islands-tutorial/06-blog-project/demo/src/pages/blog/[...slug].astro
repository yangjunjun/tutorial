---
/**
 * 文章详情页 — 支持 MDX 内容渲染
 *
 * 功能：
 * - MDX Content 渲染
 * - Vue Island: 文章目录（client:idle）
 * - Vue Island: 暗黑模式切换（client:load）
 * - 分享按钮
 * - 相关文章推荐
 * - 上一篇/下一篇导航
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostLayout from '../../layouts/PostLayout.astro';
import TagList from '../../components/TagList.astro';
import TableOfContents from '../../components/vue/TableOfContents.vue';
import { getCollection } from 'astro:content';
import { getReadingTime } from '../../utils/reading-time';

// 生成所有文章的静态路径
export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => {
    return data.draft !== true;
  });

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();

// 计算阅读时间
const readingTime = getReadingTime(post.body || '');

// 格式化日期
const formattedDate = post.data.date.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// 获取同分类的相关文章（排除当前文章，最多 3 篇）
const allPosts = await getCollection('posts', ({ data }) => data.draft !== true);
const relatedPosts = allPosts
  .filter(p => p.data.category === post.data.category && p.slug !== post.slug)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

// 获取上一篇和下一篇（按日期排序）
const sortedPosts = allPosts.sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const currentIndex = sortedPosts.findIndex(p => p.slug === post.slug);
const prevPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;
const nextPost = currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : null;

// 当前页面 URL（用于分享）
const pageUrl = `${Astro.site?.toString().replace(/\/$/, '')}/blog/${post.slug}/`;
---

<BaseLayout
  title={`${post.data.title} - Astro Vue Islands 博客`}
  description={post.data.description}
>
  <PostLayout post={post} headings={headings} readingTime={readingTime}>
    <!-- 文章目录 — Vue Island，空闲时加载 -->
    <div class="toc-wrapper" slot="sidebar">
      <TableOfContents client:idle headings={headings} />
    </div>

    <!-- 文章正文 — MDX 渲染 -->
    <article class="post-content prose">
      <Content />
    </article>

    <!-- 分享按钮 -->
    <div class="share-section" slot="footer-before">
      <h3>分享这篇文章</h3>
      <div class="share-buttons">
        <a
          href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(pageUrl)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="share-btn"
        >
          Twitter / X
        </a>
        <a
          href={`https://www.reddit.com/submit?url=${encodeURIComponent(pageUrl)}&title=${encodeURIComponent(post.data.title)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="share-btn"
        >
          Reddit
        </a>
        <button
          class="share-btn copy-btn"
          onclick="navigator.clipboard.writeText(window.location.href).then(()=>this.textContent='已复制!')"
        >
          复制链接
        </button>
      </div>
    </div>

    <!-- 相关文章推荐 -->
    <div class="related-posts" slot="footer-after">
      {relatedPosts.length > 0 && (
        <>
          <h3>相关推荐</h3>
          <div class="related-grid">
            {relatedPosts.map(related => (
              <a href={`/blog/${related.slug}/`} class="related-card">
                <span class="related-category">{related.data.category}</span>
                <h4>{related.data.title}</h4>
                <p>{related.data.description}</p>
              </a>
            ))}
          </div>
        </>
      )}
    </div>

    <!-- 上一篇/下一篇导航 -->
    <div class="post-nav" slot="footer-after">
      {prevPost && (
        <a href={`/blog/${prevPost.slug}/`} class="nav-link nav-prev">
          <span class="nav-label">上一篇</span>
          <span class="nav-title">{prevPost.data.title}</span>
        </a>
      )}
      {nextPost && (
        <a href={`/blog/${nextPost.slug}/`} class="nav-link nav-next">
          <span class="nav-label">下一篇</span>
          <span class="nav-title">{nextPost.data.title}</span>
        </a>
      )}
    </div>
  </PostLayout>
</BaseLayout>

<style>
  /* 文章目录包装器 */
  .toc-wrapper {
    position: sticky;
    top: 2rem;
    max-height: calc(100vh - 4rem);
    overflow-y: auto;
  }

  /* 文章正文样式 */
  .post-content {
    line-height: 1.8;
    font-size: 1.05rem;
  }

  .post-content :global(h2) {
    margin-top: 2.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border, #e2e8f0);
  }

  .post-content :global(h3) {
    margin-top: 2rem;
  }

  .post-content :global(pre) {
    border-radius: 8px;
    padding: 1.25rem;
    overflow-x: auto;
    background: var(--color-code-bg, #1e293b);
  }

  .post-content :global(code) {
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 0.9em;
  }

  .post-content :global(p > code) {
    background: var(--color-inline-code-bg, #f1f5f9);
    padding: 0.15em 0.4em;
    border-radius: 4px;
    color: var(--color-primary, #6366f1);
  }

  .post-content :global(blockquote) {
    border-left: 4px solid var(--color-primary, #6366f1);
    padding-left: 1rem;
    margin-left: 0;
    color: var(--color-text-muted, #64748b);
    font-style: italic;
  }

  .post-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
  }

  .post-content :global(th),
  .post-content :global(td) {
    border: 1px solid var(--color-border, #e2e8f0);
    padding: 0.5rem 1rem;
    text-align: left;
  }

  .post-content :global(th) {
    background: var(--color-card-bg, #f8fafc);
    font-weight: 600;
  }

  .post-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }

  /* 分享按钮 */
  .share-section {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border, #e2e8f0);
  }

  .share-section h3 {
    margin-bottom: 1rem;
  }

  .share-buttons {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .share-btn {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: var(--color-card-bg, #f8fafc);
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: 8px;
    text-decoration: none;
    color: var(--color-text, #1a1a2e);
    font-size: 0.9rem;
    cursor: pointer;
    transition: border-color 0.2s;
  }

  .share-btn:hover {
    border-color: var(--color-primary, #6366f1);
    color: var(--color-primary, #6366f1);
  }

  /* 相关文章 */
  .related-posts {
    margin-top: 2rem;
  }

  .related-posts h3 {
    margin-bottom: 1rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1rem;
  }

  .related-card {
    padding: 1.25rem;
    background: var(--color-card-bg, #f8fafc);
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: 12px;
    text-decoration: none;
    color: var(--color-text, #1a1a2e);
    transition: transform 0.2s, border-color 0.2s;
  }

  .related-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-primary, #6366f1);
  }

  .related-category {
    font-size: 0.8rem;
    color: var(--color-primary, #6366f1);
    font-weight: 600;
    text-transform: uppercase;
  }

  .related-card h4 {
    margin: 0.5rem 0;
    font-size: 1rem;
  }

  .related-card p {
    font-size: 0.85rem;
    color: var(--color-text-muted, #64748b);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* 上/下一篇导航 */
  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 2rem;
  }

  .nav-link {
    padding: 1.25rem;
    background: var(--color-card-bg, #f8fafc);
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: 12px;
    text-decoration: none;
    color: var(--color-text, #1a1a2e);
    transition: border-color 0.2s;
  }

  .nav-link:hover {
    border-color: var(--color-primary, #6366f1);
  }

  .nav-next {
    text-align: right;
  }

  .nav-label {
    display: block;
    font-size: 0.8rem;
    color: var(--color-text-muted, #64748b);
    margin-bottom: 0.25rem;
  }

  .nav-title {
    font-weight: 600;
    font-size: 0.95rem;
  }

  /* 响应式 */
  @media (max-width: 768px) {
    .post-nav {
      grid-template-columns: 1fr;
    }
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
