---
/**
 * 标签总览页 — 列出所有标签及其文章数量
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts', ({ data }) => data.draft !== true);

// 统计每个标签的文章数量
const tagCounts: Record<string, number> = {};
allPosts.forEach(post => {
  post.data.tags.forEach(tag => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});

// 按文章数量降序排列
const sortedTags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);

// 统计每个分类的文章数量
const categoryCounts: Record<string, number> = {};
allPosts.forEach(post => {
  const cat = post.data.category;
  categoryCounts[cat] = (categoryCounts[cat] || 0) + 1;
});
const sortedCategories = Object.entries(categoryCounts).sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="标签 - Astro Vue Islands 博客" description="浏览所有文章标签和分类">
  <h1>标签与分类</h1>
  <p class="subtitle">通过标签和分类快速找到你感兴趣的文章</p>

  <!-- 分类区域 -->
  <section class="section">
    <h2>分类</h2>
    <div class="tag-grid">
      {sortedCategories.map(([category, count]) => (
        <a href={`/tags?category=${encodeURIComponent(category)}`} class="tag-card category">
          <span class="tag-name">{category}</span>
          <span class="tag-count">{count} 篇文章</span>
        </a>
      ))}
    </div>
  </section>

  <!-- 标签区域 -->
  <section class="section">
    <h2>所有标签</h2>
    <div class="tag-grid">
      {sortedTags.map(([tag, count]) => (
        <a href={`/tags/${tag}/`} class="tag-card">
          <span class="tag-name">{tag}</span>
          <span class="tag-count">{count} 篇文章</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  h1 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .subtitle {
    color: var(--color-text-muted, #64748b);
    margin-bottom: 2rem;
  }

  .section {
    margin-bottom: 3rem;
  }

  .section h2 {
    font-size: 1.3rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--color-border, #e2e8f0);
  }

  .tag-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
  }

  .tag-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.25rem;
    background: var(--color-card-bg, #f8fafc);
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: 10px;
    text-decoration: none;
    color: var(--color-text, #1a1a2e);
    transition: transform 0.2s, border-color 0.2s;
  }

  .tag-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-primary, #6366f1);
  }

  .tag-card.category {
    background: var(--color-primary-light, #eef2ff);
    border-color: transparent;
  }

  .tag-name {
    font-weight: 600;
  }

  .tag-count {
    font-size: 0.85rem;
    color: var(--color-text-muted, #64748b);
    background: var(--color-border, #e2e8f0);
    padding: 0.2rem 0.6rem;
    border-radius: 12px;
  }

  @media (max-width: 768px) {
    .tag-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
