---
/**
 * Pagination.astro — 分页导航组件
 *
 * 基于 Astro.paginate 的 URL 对象生成分页导航
 * 包含：上一页/下一页按钮 + 页码链接 + 当前页指示
 */

interface Props {
  url: {
    prev?: string;
    next?: string;
    current: string;
  };
  currentPage: number;
  lastPage: number;
  prevPage?: string;
  nextPage?: string;
}

const { url, currentPage, lastPage, prevPage, nextPage } = Astro.props;

// 生成要显示的页码数组
// 逻辑：当前页前后各显示 2 页，首尾始终显示
function getPageNumbers(current: number, total: number): (number | '...')[] {
  const pages: (number | '...')[] = [];

  if (total <= 7) {
    // 总页数少，全部显示
    for (let i = 1; i <= total; i++) pages.push(i);
    return pages;
  }

  // 始终显示第 1 页
  pages.push(1);

  if (current > 3) {
    pages.push('...');
  }

  // 当前页前后各 1 页
  for (let i = Math.max(2, current - 1); i <= Math.min(total - 1, current + 1); i++) {
    pages.push(i);
  }

  if (current < total - 2) {
    pages.push('...');
  }

  // 始终显示最后一页
  if (total > 1) {
    pages.push(total);
  }

  return pages;
}

const pageNumbers = getPageNumbers(currentPage, lastPage);
---

{lastPage > 1 && (
  <nav class="pagination" aria-label="分页导航">
    <!-- 上一页 -->
    {prevPage ? (
      <a href={prevPage} class="page-btn page-prev" aria-label="上一页">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
          <polyline points="15 18 9 12 15 6" />
        </svg>
        上一页
      </a>
    ) : (
      <span class="page-btn page-prev disabled" aria-disabled="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
          <polyline points="15 18 9 12 15 6" />
        </svg>
        上一页
      </span>
    )}

    <!-- 页码 -->
    <div class="page-numbers">
      {pageNumbers.map((num) => {
        if (num === '...') {
          return <span class="page-ellipsis">...</span>;
        }
        const href = num === 1 ? '/blog' : `/blog/${num}`;
        return (
          <a
            href={href}
            class:list={['page-num', { current: num === currentPage }]}
            aria-label={`第 ${num} 页`}
            aria-current={num === currentPage ? 'page' : undefined}
          >
            {num}
          </a>
        );
      })}
    </div>

    <!-- 下一页 -->
    {nextPage ? (
      <a href={nextPage} class="page-btn page-next" aria-label="下一页">
        下一页
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
          <polyline points="9 18 15 12 9 6" />
        </svg>
      </a>
    ) : (
      <span class="page-btn page-next disabled" aria-disabled="true">
        下一页
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
          <polyline points="9 18 15 12 9 6" />
        </svg>
      </span>
    )}
  </nav>
)}

<style>
  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border, #e2e8f0);
  }

  .page-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.5rem 1rem;
    background: var(--color-card-bg, #f8fafc);
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: 8px;
    text-decoration: none;
    color: var(--color-text, #1a1a2e);
    font-size: 0.9rem;
    font-weight: 500;
    transition: border-color 0.2s, color 0.2s;
  }

  .page-btn:hover:not(.disabled) {
    border-color: var(--color-primary, #6366f1);
    color: var(--color-primary, #6366f1);
  }

  .page-btn.disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .page-numbers {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .page-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    text-decoration: none;
    color: var(--color-text, #1a1a2e);
    font-size: 0.9rem;
    font-weight: 500;
    transition: background 0.2s, color 0.2s;
  }

  .page-num:hover {
    background: var(--color-primary-light, #eef2ff);
    color: var(--color-primary, #6366f1);
  }

  .page-num.current {
    background: var(--color-primary, #6366f1);
    color: white;
  }

  .page-ellipsis {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    color: var(--color-text-muted, #64748b);
    font-size: 0.9rem;
  }

  /* 响应式 */
  @media (max-width: 768px) {
    .pagination {
      flex-wrap: wrap;
    }
    .page-btn {
      font-size: 0.85rem;
      padding: 0.4rem 0.75rem;
    }
    .page-num {
      width: 32px;
      height: 32px;
      font-size: 0.85rem;
    }
  }
</style>
