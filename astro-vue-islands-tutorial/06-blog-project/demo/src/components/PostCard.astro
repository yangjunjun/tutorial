---
/**
 * PostCard.astro — 可复用的文章卡片组件
 *
 * 用于在列表页展示文章摘要信息
 */
import { getReadingTime } from '../utils/reading-time';

interface Props {
  title: string;
  date: Date;
  description: string;
  tags: string[];
  href: string;
  readingTime?: string;
}

const { title, date, description, tags, href, readingTime } = Astro.props;

// 格式化日期为中文格式
const formattedDate = date.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<a href={href} class="post-card">
  <div class="card-content">
    <!-- 日期和阅读时间 -->
    <div class="card-meta">
      <time datetime={date.toISOString()}>{formattedDate}</time>
      {readingTime && (
        <>
          <span class="dot">·</span>
          <span class="reading-time">{readingTime}</span>
        </>
      )}
    </div>

    <!-- 标题 -->
    <h3 class="card-title">{title}</h3>

    <!-- 描述 -->
    <p class="card-description">{description}</p>

    <!-- 标签 -->
    <div class="card-tags">
      {tags.map(tag => (
        <span class="tag">{tag}</span>
      ))}
    </div>
  </div>
</a>

<style>
  .post-card {
    display: block;
    background: var(--color-card-bg, #f8fafc);
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: 12px;
    text-decoration: none;
    color: var(--color-text, #1a1a2e);
    transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
    overflow: hidden;
  }

  .post-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-primary, #6366f1);
    box-shadow: 0 8px 24px var(--color-shadow, rgba(0, 0, 0, 0.08));
  }

  .card-content {
    padding: 1.5rem;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--color-text-muted, #64748b);
    margin-bottom: 0.75rem;
  }

  .dot {
    opacity: 0.5;
  }

  .card-title {
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.4;
    margin-bottom: 0.5rem;
    /* 最多显示 2 行 */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-description {
    font-size: 0.9rem;
    color: var(--color-text-muted, #64748b);
    line-height: 1.6;
    margin-bottom: 1rem;
    /* 最多显示 3 行 */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    font-size: 0.75rem;
    padding: 0.15rem 0.5rem;
    background: var(--color-primary-light, #eef2ff);
    color: var(--color-primary, #6366f1);
    border-radius: 12px;
    font-weight: 500;
  }
</style>
