---
/**
 * DeployBadge.astro — 部署信息徽章组件
 *
 * 显示当前部署的平台信息和构建时间
 */

interface Props {
  buildTime: string;
  platform?: string;
}

const { buildTime, platform = 'static' } = Astro.props;

// 格式化构建时间
const formattedTime = new Date(buildTime).toLocaleString('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
  hour: '2-digit',
  minute: '2-digit',
  second: '2-digit',
});
---

<div class="deploy-badge">
  <div class="badge-row">
    <span class="badge-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
        <polyline points="22 4 12 14.01 9 11.01" />
      </svg>
    </span>
    <div class="badge-info">
      <span class="badge-label">部署状态</span>
      <span class="badge-value success">构建成功</span>
    </div>
  </div>

  <div class="badge-details">
    <div class="detail-item">
      <span class="detail-label">部署模式</span>
      <span class="detail-value">{platform}</span>
    </div>
    <div class="detail-item">
      <span class="detail-label">构建时间</span>
      <span class="detail-value">{formattedTime}</span>
    </div>
    <div class="detail-item">
      <span class="detail-label">Astro</span>
      <span class="detail-value">{Astro.generator || '4.x'}</span>
    </div>
  </div>
</div>

<style>
  .deploy-badge {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 12px;
    padding: 1.25rem;
    margin-bottom: 2rem;
  }

  .badge-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .badge-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: #065f46;
    border-radius: 10px;
    color: #34d399;
  }

  .badge-info {
    display: flex;
    flex-direction: column;
  }

  .badge-label {
    font-size: 0.8rem;
    color: #94a3b8;
  }

  .badge-value {
    font-weight: 700;
    font-size: 1.1rem;
  }

  .badge-value.success {
    color: #34d399;
  }

  .badge-details {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid #334155;
  }

  .detail-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .detail-label {
    font-size: 0.75rem;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .detail-value {
    font-size: 0.9rem;
    color: #e2e8f0;
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .badge-details {
      grid-template-columns: 1fr;
    }
  }
</style>
